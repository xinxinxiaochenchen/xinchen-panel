# Installer generates .env, database password and proxy key automatically.
# Manual deployment: copy to .env (0600) and prepare proxy.key.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
CONTROL_DEPLOYMENT_MODE=http
CONTROL_BIND_IP=0.0.0.0
CONTROL_BROWSER_AUTH_ENABLED=true
CONTROL_BROWSER_COOKIE_SECURE=false
CONTROL_PROXY_CREDENTIAL_SECRET_DIR=/opt/xinchen-panel/.local/secrets/proxy
# HTTPS proxy: mode=https, bind=127.0.0.1, cookie_secure=true.
# Read-only preview: mode=preview, browser_auth_enabled=false.
# Persist optional node-control settings here so upgrades preserve them.
# CONTROL_AGENT_TLS_DIR=/opt/xinchen-panel/secrets/agent-tls
# CONTROL_AGENT_BIND_IP=0.0.0.0
# CONTROL_RELAY_SECRET_DIR=/opt/xinchen-panel/secrets/relay
# Node VPS with a Git checkout instead of a prebuilt release:
# CONTROL_AGENT_DOCKERFILE=deployments/compose/Dockerfile.agent.source
