# Copy this file to .env and set a long random password. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
# Keep loopback for a reverse proxy. Set 0.0.0.0 only for a temporary IP preview.
CONTROL_BIND_IP=127.0.0.1
# Enable only after HTTPS reverse proxy is working and CONTROL_BIND_IP is loopback.
CONTROL_BROWSER_AUTH_ENABLED=false
